# WhatsApp Provider Configuration
# Supported providers: wwebjs, zapo (whaileys is an alias of zapo)
WHATSAPP_PROVIDER=wwebjs

# Logging (silent, fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
# Log level for the zapo provider (trace, debug, info, warn, error)
ZAPO_LOG_LEVEL=error
# SQLite file where the zapo provider keeps WhatsApp session state
ZAPO_AUTH_PATH=.zapo_auth/state.sqlite

# Chrome/Puppeteer Configuration
CHROME_BIN=
CHROME_WS=
CHROME_ARGS=--no-sandbox --disable-setuid-sandbox

# Database
DB_HOST=localhost
DB_DIALECT=mysql
DB_PORT=3306
DB_NAME=whaticket
DB_USER=root
DB_PASS=

# JWT Secrets
JWT_SECRET=mysecret
JWT_REFRESH_SECRET=myanothersecret

# Backend URL
BACKEND_URL=http://localhost:8080

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Proxy
PROXY_PORT=8080
